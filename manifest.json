{
  "manifest_version": 3,
  "name": "Kite Bot Status",
  "version": "1.9.0",
  "description": "See your Kite bot's status and credits used this month from the toolbar.",
  "action": {
    "default_title": "Kite Bot Status",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "toolbar16.png",
      "32": "toolbar32.png",
      "48": "toolbar48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://api.kite.onl/*"
  ]
}