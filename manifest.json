{
  "manifest_version": 3,
  "name": "Kite Bot Status",
  "version": "0.2.0",
  "version_name": "beta-v0.2",
  "description": "See your Kite bot's status and credits used this month from the toolbar.",
  "action": {
    "default_title": "Kite Bot Status",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/toolbar16.png",
      "32": "icons/toolbar32.png",
      "48": "icons/toolbar48.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://api.kite.onl/*"
  ]
}